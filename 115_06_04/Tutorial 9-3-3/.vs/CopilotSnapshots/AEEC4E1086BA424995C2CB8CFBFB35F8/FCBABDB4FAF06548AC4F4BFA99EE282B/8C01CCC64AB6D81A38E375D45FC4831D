namespace Tutorial_9_3_3
{
    public partial class MainForm : Form
    {
        private List<BankAccount> accounts = new List<BankAccount>();

        public MainForm()
        {
            InitializeComponent();
        }

        private void buttonExit_Click(object sender, EventArgs e)
        {
            this.Close();
        }

        private void buttonOpenAccount_Click(object sender, EventArgs e)
        {
            OpenAccountForm openAccountForm = new OpenAccountForm(accounts);
            openAccountForm.ShowDialog();
            
            // 更新已開戶人數顯示
            labelAccountCount.Text = $"已開戶人數：{accounts.Count}";
        }
    }
}
